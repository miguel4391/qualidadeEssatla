<%- include('partials/header') %>

<div class="container mt-5">
	<div class="row">
		<div class="col-md-12">
			<p class="h2 text-red">Guias Operacionais</p>
		</div>
	</div>
    <div class="row">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Search" name="searchInput" id="searchInput">        
        </div>
    </div>
    <div class="row mt-3">
        <table class="table table-striped" name="fileTable" id="fileTable">
          <thead>
            <tr class="text-red">
              <th scope="col">Código</th>
              <th scope="col">Designação</th>
              <th scope="col">Área Funcional</th>          
            </tr>
          </thead>
          <tbody>
                <% guias.forEach(function(file){ %>
                    <tr>
                        <td><a href="<%= file.path %>" target="_blank"><%= file.cod %></a></td>
                        <td><a href="<%= file.path %>" target="_blank"><%= file.nome %></a></td>
                        <td><a href="<%= file.path %>" target="_blank"><%= file.departamento %></a></td>
                    </tr>
                <% }) %>
          </tbody>
        </table>
    </div>
    <div class="row my-3">
      <a href="back" class="btn btn-outline-primary"><i class="fas fa-angle-double-left"></i></a>
    </div>
</div>

<script src="javascript/searchfilter.js" type="text/javascript"></script>

<%- include('partials/footer') %>
