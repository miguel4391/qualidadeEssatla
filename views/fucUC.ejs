			<div class="col-12">
				<table>
					<thead>	
						<tr><th><label class="mx-3">Designação da Unidade Curricular</label></th></tr>
					</thead>
					<tbody>
						<tr>
							<td>
								<div class="form-floating">
									<input type="text" class="form-control form-control-sm" id="ptTitle" name="ptTitle" placeholder="nomePt" value="<%= fuc[0].nomeUCPt %>" readonly>
									<label for="ptTitle">PT:</label>
								</div>
							</td>
						</tr>
						<tr>
							<td>
								<div class="form-floating mb-3">
									<input type="text" class="form-control form-control-sm" id="enTitle" name="enTitle" placeholder="nomePt" value="<%= fuc[0].noemUCEn %>"readonly>
								<label for="enTitle">EN:</label>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class="row mt-5">
			<div class="col-12">
