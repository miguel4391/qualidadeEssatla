<%- include('partials/header') %>

<style>
.blueheader{
	background-color: #f8bb00;
	color:#fff;
}
table{
	width: 100%;
}

th{
	background-color: #f8bb00;
	color:#fff;
	
	padding: 0.7em;
}
.fs-04{
	font-size: .75em;
	font-style: italic;
}
</style>


<div class="container">

	<div class="d-flex justify-content-end mt-3">
		<a href="/pdf/<%= fuc[0].nomeCE %>/<%= fuc[0].nomeUCPt %>/<%= fuc[0].anoLetivoFuc.replace('/', '_') %>" class="btn btn-outline-danger" >Exportar para PDF <i class="fa-solid fa-file-pdf"></i></a> 
	</div>

