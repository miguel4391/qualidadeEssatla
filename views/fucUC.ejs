						</tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class="row mt-5">
			<div class="col-12">
				<table>
					<thead>
						<tr>
							<th>Código UC</th>
							<th>Sigla da área científica</th>
							<th>Ano</th>
							<th>Semestre</th>
							<th>Escolher</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><input type="text" class="form-control form-control-sm" id="codUC" name="codUC" placeholder="Não preencher" disabled="disabled"></td>
