							<td><input type="text" class="form-control form-control-sm" id="semestre" name="semestre" value="<%= fuc[0].semestre  %>" readonly ></td>
							<td><input type="text" class="form-control form-control-sm" id="regime" name="regime" value="<%= fuc[0].regime  %>" readonly ></td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
