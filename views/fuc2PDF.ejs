    const addFooters = doc => {
        const pageCount = doc.internal.getNumberOfPages()
                
        doc.setFont('helvetica', 'italic')
        doc.setFontSize(8)
        
        for (var i = 1; i <= pageCount; i++) {
            const fuc = doc.splitTextToSize('<%= fuc[0].nomeUCPt %>',70, {} )
            doc.text(fuc ,14, 287,{align:'left'})
            doc.setPage(i)
            doc.text('Página ' + String(i) + ' de ' + String(pageCount), doc.internal.pageSize.width / 2, 287, {
            align: 'center'
            })
            const curso = doc.splitTextToSize('<%= curso %>',70, {} )
            doc.text(curso,doc.internal.pageSize.width -14, 287,{align:'right'})
            
        }
        
    }
